{
  "name": "speedcuber356",
  "productName": "SpeedCuber356",
  "private": true,
  "license": "MIT",
  "version": "0.2.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --mac --dir",
    "test": "node test/cube.test.js"
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "cubejs": "^1.3.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "gan-web-bluetooth": "^3.0.2",
    "rxjs": "^7.8.2",
    "three": "^0.186.1",
    "vite": "^8.3.5"
  },
  "description": "Speedcubing trainer for GAN smart cubes",
  "build": {
    "appId": "de.youvendo.speedcuber356",
    "productName": "SpeedCuber356",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": "dir",
      "identity": null,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "SpeedCuber356 connects to your smart cube over Bluetooth."
      }
    }
  },
  "dependencies": {
    "@stoprocent/noble": "^2.8.0"
  }
}
